BOT_PN=628XXXXXXXXXX

#kosongin kalo mau login pake QR
#kalo diisi: 8 karakter (XXXX-XXXX atau XXXXXXXX), huruf/angka valid: 123456789ABCDEFGHJKLMNPQRSTVWXYZ
PAIRING_CODE=SEXYSEXY

#self = cuma owner yang bisa pake command, public = semua orang bisa (command non-owner)
BOT_MODE=self

#plugin eval/shell, tetep owner-only. default false, ganti true kalo emang butuh
ENABLE_UNSAFE=false
